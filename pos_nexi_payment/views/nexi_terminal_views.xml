<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- NEXI Terminal Tree View -->
    <record id="view_nexi_terminal_tree" model="ir.ui.view">
        <field name="name">nexi.terminal.tree</field>
        <field name="model">nexi.terminal</field>
        <field name="arch" type="xml">
            <list string="NEXI Terminals" decoration-success="state == 'active'" decoration-danger="state == 'error'" decoration-muted="state == 'inactive'">
                <field name="name"/>
                <field name="terminal_id"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'error'" decoration-muted="state == 'inactive'"/>
                <field name="last_heartbeat" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- NEXI Terminal Form View -->
    <record id="view_nexi_terminal_form" model="ir.ui.view">
        <field name="name">nexi.terminal.form</field>
        <field name="model">nexi.terminal</field>
        <field name="arch" type="xml">
            <form string="NEXI Terminal">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary" icon="fa-plug" groups="pos_nexi_payment.group_nexi_user"/>
                    <button name="action_recover_unconfirmed" string="Recover Unconfirmed" type="object" class="btn-secondary" icon="fa-search" invisible="state != 'active'" groups="pos_nexi_payment.group_nexi_manager"/>
                    <button name="action_activate" string="Activate" type="object" class="btn-success" icon="fa-check" invisible="state != 'inactive'" groups="pos_nexi_payment.group_nexi_manager"/>
                    <button name="action_deactivate" string="Deactivate" type="object" class="btn-warning" icon="fa-pause" invisible="state in ('inactive', 'error')" groups="pos_nexi_payment.group_nexi_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="inactive,active,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Terminal Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Terminal Information">
                            <field name="terminal_id" placeholder="e.g., TERM001"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="API Credentials">
                            <field name="api_key_id" groups="pos_nexi_payment.group_nexi_admin"/>
                            <field name="api_key_encrypted" password="True" groups="pos_nexi_payment.group_nexi_admin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="POS Configurations" name="pos_configs">
                            <field name="pos_config_ids"/>
                        </page>
                        <page string="Status" name="status">
                            <group>
                                <field name="last_heartbeat" readonly="1"/>
                                <field name="transaction_count" readonly="1"/>
                                <field name="success_rate" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- NEXI Terminal Search View -->
    <record id="view_nexi_terminal_search" model="ir.ui.view">
        <field name="name">nexi.terminal.search</field>
        <field name="model">nexi.terminal</field>
        <field name="arch" type="xml">
            <search string="NEXI Terminals">
                <field name="name"/>
                <field name="terminal_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Inactive" name="inactive" domain="[('state', '=', 'inactive')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- NEXI Terminal Action -->
    <record id="action_nexi_terminal" model="ir.actions.act_window">
        <field name="name">NEXI Terminals</field>
        <field name="res_model">nexi.terminal</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_nexi_terminal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first NEXI Terminal
            </p>
            <p>
                Configure NEXI payment terminals to process card payments in your Point of Sale.
            </p>
        </field>
    </record>
</odoo>
