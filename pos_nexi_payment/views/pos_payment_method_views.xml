<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit POS Payment Method Form to add NEXI fields -->
    <record id="view_pos_payment_method_form_nexi" model="ir.ui.view">
        <field name="name">pos.payment.method.form.nexi</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <!-- Add NEXI fields after the journal_id field -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_nexi_payment"/>
            </xpath>
            
            <!-- Add terminal selection when is_nexi_payment is True -->
            <xpath expr="//sheet" position="inside">
                <group string="NEXI Configuration" invisible="not is_nexi_payment">
                    <field name="nexi_terminal_id" 
                           required="is_nexi_payment"
                           invisible="not is_nexi_payment"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit POS Payment Method List to show NEXI indicator -->
    <record id="view_pos_payment_method_list_nexi" model="ir.ui.view">
        <field name="name">pos.payment.method.list.nexi</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_nexi_payment" string="NEXI" widget="boolean_toggle" optional="show"/>
                <field name="nexi_terminal_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
