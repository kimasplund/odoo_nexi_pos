<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Multi-Company Rules (Global) -->
        <record id="nexi_terminal_company_rule" model="ir.rule">
            <field name="name">NEXI Terminal: Multi-Company</field>
            <field name="model_id" ref="model_nexi_terminal"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="nexi_transaction_company_rule" model="ir.rule">
            <field name="name">NEXI Transaction: Multi-Company</field>
            <field name="model_id" ref="model_nexi_transaction"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- User-level: Can only see own transactions -->
        <record id="nexi_transaction_user_rule" model="ir.rule">
            <field name="name">NEXI Transaction: User Can See Own Transactions</field>
            <field name="model_id" ref="model_nexi_transaction"/>
            <field name="groups" eval="[(4, ref('group_nexi_user'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <!-- Manager-level: Can see all transactions -->
        <record id="nexi_transaction_manager_rule" model="ir.rule">
            <field name="name">NEXI Transaction: Manager Can See All Transactions</field>
            <field name="model_id" ref="model_nexi_transaction"/>
            <field name="groups" eval="[(4, ref('group_nexi_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
