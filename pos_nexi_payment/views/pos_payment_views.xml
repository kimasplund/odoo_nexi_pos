<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit POS Payment Form to add NEXI transaction reference -->
    <record id="view_pos_payment_form_nexi" model="ir.ui.view">
        <field name="name">pos.payment.form.nexi</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_id" position="after">
                <field name="nexi_transaction_id" 
                       invisible="not nexi_transaction_id"
                       options="{'no_create': True, 'no_edit': True}"/>
            </field>
        </field>
    </record>

    <!-- Inherit POS Payment List to add NEXI transaction info -->
    <record id="view_pos_payment_list_nexi" model="ir.ui.view">
        <field name="name">pos.payment.list.nexi</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <field name="payment_method_id" position="after">
                <field name="nexi_transaction_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
