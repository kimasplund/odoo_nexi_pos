<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for NEXI Terminal External IDs -->
        <record id="seq_nexi_terminal" model="ir.sequence">
            <field name="name">NEXI Terminal</field>
            <field name="code">nexi.terminal</field>
            <field name="prefix">NEXI-TERM-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <!-- Sequence for NEXI Transaction References -->
        <record id="seq_nexi_transaction" model="ir.sequence">
            <field name="name">NEXI Transaction</field>
            <field name="code">nexi.transaction</field>
            <field name="prefix">NEXI-%(year)s%(month)s%(day)s-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
        </record>
    </data>
</odoo>
