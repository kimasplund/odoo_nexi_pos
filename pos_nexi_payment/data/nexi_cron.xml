<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Recover unconfirmed transactions every 15 minutes -->
        <record id="ir_cron_nexi_recover_unconfirmed" model="ir.cron">
            <field name="name">NEXI: Recover Unconfirmed Transactions</field>
            <field name="model_id" ref="model_nexi_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_recover_unconfirmed()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Poll stalled transactions every 5 minutes -->
        <record id="ir_cron_nexi_poll_pending" model="ir.cron">
            <field name="name">NEXI: Poll Pending Transactions</field>
            <field name="model_id" ref="model_nexi_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_pending_transactions()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Clean up old failed/cancelled transactions daily -->
        <record id="ir_cron_nexi_cleanup_old" model="ir.cron">
            <field name="name">NEXI: Cleanup Old Transactions</field>
            <field name="model_id" ref="model_nexi_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_transactions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
